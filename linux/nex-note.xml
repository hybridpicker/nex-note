    <comment>Nex Note project</comment>
    <glob pattern="*.nxn"/>
  </mime-type>
  <mime-type type="application/x-musescore">
    <comment>MuseScore score</comment>
    <glob pattern="*.mscz"/>
  </mime-type>
  <mime-type type="application/vnd.recordare.musicxml">
    <comment>Compressed MusicXML</comment>
    <glob pattern="*.mxl"/>
  </mime-type>
  <mime-type type="application/x-guitar-pro">
    <comment>Guitar Pro tablature</comment>
    <glob pattern="*.gp"/>
