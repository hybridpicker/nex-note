#!/bin/sh

set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ "${NEX_NOTE_SKIP_POST_COMMIT_BUILD:-}" = "1" ]; then
  echo "nex-note post-commit: skipped macOS build because NEX_NOTE_SKIP_POST_COMMIT_BUILD=1"
  exit 0
fi

if [ "$(uname -s)" != "Darwin" ]; then
  echo "nex-note post-commit: skipped macOS build because this is not macOS"
  exit 0
fi

# The DMG is built from the new commit in a separate checkout and in the background, so the
# commit returns at once and uncommitted work in progress is neither included nor disturbed.
# Result: dist/dmg/Nex Note-latest.dmg (log: dist/dmg/build.log).
echo "nex-note post-commit: building the latest DMG in the background"
npm run --silent dmg:latest -- --background || echo "nex-note post-commit: could not start the DMG build"
