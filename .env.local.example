# nex-note — Environment Variables
# Copy this file to .env.local and fill in your keys.
# Only OLLAMA_* keys are needed if you run Ollama locally (no API key required for localhost).

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Leave empty to use local Ollama (http://localhost:11434)
# Set to use Ollama Cloud (https://ollama.com)
OLLAMA_API_KEY=

# ─── Claude (Anthropic) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Script Paths ─────────────────────────────────────────────────────────────
# Path to pdf-to-musescore.sh (default: ~/Coding/musescore/scripts/pdf-to-musescore.sh)
PDF_TO_MUSESCORE_SCRIPT=

# ─── Iframe Embed ─────────────────────────────────────────────────────────────
# Optional same-origin endpoint for /?embed=1&entry=... startup.
# Supports {entry} or {entryId}; otherwise nex-note appends ?entry=...
NEXT_PUBLIC_NEX_NOTE_EMBED_DATA_ENDPOINT=
